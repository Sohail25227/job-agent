# Copy to .env and fill in only what you need. Everything here is optional for
# local use: with no keys at all it still finds and ranks jobs, using SQLite and
# the built-in fallbacks.

# ---- Deployment -----------------------------------------------------------
# Where the data lives. Unset means a local SQLite file at data/jobs.db, which
# is right for a laptop and wrong for a deploy (the disk is ephemeral there).
# A managed Postgres URL is what production wants:
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Signs session cookies. MUST be set in production: without it a new key is
# generated on every start, which logs every user out on every deploy.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set to 1 when served over HTTPS, so the session cookie refuses plain HTTP.
HTTPS_ONLY=

# Live searches spend a third-party API quota shared by every account, so each
# account gets this many per day.
DAILY_SEARCH_LIMIT=25

# ---- Job aggregators with India coverage (both free, ~1 minute each) ------
# Adzuna indexes Naukri, Indeed, Shine and company career pages.
# Free tier is 25 calls/minute and 250/day for the WHOLE app, which is what
# DAILY_SEARCH_LIMIT above is protecting.
#   https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble, a second index of the same market.
#   https://jooble.org/api/about
JOOBLE_API_KEY=

# ---- LLM (optional, pick ONE free option) ---------------------------------
# Used for two things only: structuring an uploaded resume, and suggesting
# related job titles. Without one, both fall back to built-in logic.
# 1) Ollama, fully local and free. No key needed, just:
#      brew install ollama && ollama pull qwen2.5:7b-instruct
# 2) Google Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 3) Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# 4) Paid fallback
OPENAI_API_KEY=

# ---- Local dashboard ------------------------------------------------------
JOBAGENT_HOST=127.0.0.1
JOBAGENT_PORT=8000
